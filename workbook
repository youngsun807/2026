<script>
  (function initKnowledgeLibrary() {
    const searchInput = document.getElementById('librarySearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const themeCards = document.querySelectorAll('.theme-card');
    const searchTags = document.querySelectorAll('.search-tag');
    const toast = document.getElementById('toastMessage');
    const toastText = document.getElementById('toastText');
    const carousel = document.getElementById('quoteCarousel');
    const prevBtn = document.getElementById('carouselPrevBtn');
    const nextBtn = document.getElementById('carouselNextBtn');

    function showToast(msg) {
      if (!toast || !toastText) return;
      toastText.textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2400);
    }

    // Search Input handling
    if (searchInput && clearBtn) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        if (query.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        // Live visual highlight filter for category cards
        themeCards.forEach((card) => {
          const text = card.textContent.toLowerCase();
          if (query === '' || text.includes(query.toLowerCase())) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });

      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        themeCards.forEach((card) => card.style.display = 'flex');
        searchInput.focus();
      });
    }

    // Recommended pills click to search
    searchTags.forEach(btn => {
      btn.addEventListener('click', () => {
        const term = btn.textContent.trim();
        if (searchInput) {
          searchInput.value = term;
          searchInput.dispatchEvent(new Event('input'));
          showToast(`'${term}' 키워드로 검색했습니다.`);
        }
      });
    });

    // Bookmark Toggle Interaction
    document.querySelectorAll('.quote-bookmark-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const icon = btn.querySelector('.material-symbols-outlined');
        if (!icon) return;
        const isFilled = icon.style.fontVariationSettings && icon.style.fontVariationSettings.includes("'FILL' 1");
        if (isFilled) {
          icon.style.fontVariationSettings = "'FILL' 0";
          btn.classList.remove('text-primary');
          btn.classList.add('text-outline');
          showToast('보관함에서 문장을 제외했습니다.');
        } else {
          icon.style.fontVariationSettings = "'FILL' 1";
          btn.classList.remove('text-outline');
          btn.classList.add('text-primary');
          showToast('문장을 북마크 보관함에 저장했습니다.');
        }
      });
    });

    // Share Button Interaction
    document.querySelectorAll('.quote-share-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const text = btn.getAttribute('data-quote') || '';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            showToast('인용 문구가 클립보드에 복사되었습니다.');
          } catch (err) {
            showToast('공유용 문구가 복사되었습니다.');
          }
        } else {
          showToast('공유용 문구가 복사되었습니다.');
        }
      });
    });

    // Carousel Navigation
    if (carousel && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -280, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: 280, behavior: 'smooth' });
      });
    }
  })();
