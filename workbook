  // Simple micro-interactions for Tag Filtering & Modal
  (function() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const timelineEntries = document.querySelectorAll('.timeline-entry');
    const fabBtn = document.getElementById('fab-new-mistake');
    const modal = document.getElementById('quick-note-modal');
    const sheet = document.getElementById('modal-sheet');
    const closeBtn = document.getElementById('close-modal-btn');
    const submitBtn = document.getElementById('submit-mistake-btn');

    // Filter interaction
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset styles
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-on-primary');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        // Set active style
        btn.classList.add('bg-primary', 'text-on-primary');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

        const filter = btn.dataset.filter;
        timelineEntries.forEach(entry => {
          if (filter === 'all') {
            entry.style.display = 'flex';
          } else {
            const categories = entry.dataset.category || '';
            if (categories.includes(filter)) {
              entry.style.display = 'flex';
            } else {
              entry.style.display = 'none';
            }
          }
        });
      });
    });

    // Modal Drawer open / close
    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        sheet.classList.remove('translate-y-full');
      }, 10);
    }

    function closeModal() {
      sheet.classList.add('translate-y-full');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 250);
    }

    if (fabBtn) fabBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (submitBtn) submitBtn.addEventListener('click', () => {
      alert('오답이 소중하게 기록되었습니다. 한 번 더 성장하셨네요!');
      closeModal();
    });
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
  })();
