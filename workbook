<script>
  function selectAnswer(buttonEl, isCorrect) {
    const parent = buttonEl.closest('[role="radiogroup"]');
    const buttons = parent.querySelectorAll('button');
    const feedbackBox = document.getElementById('quiz-feedback');
    const progressBar = document.getElementById('interactive-progress-bar');
    const stepNode3 = document.getElementById('step-node-3');

    buttons.forEach(btn => {
      btn.classList.remove('bg-secondary-container/40', 'bg-error-container/40', 'selected-quiz-row');
      btn.classList.add('bg-surface-container-low');
      const bullet = btn.querySelector('.choice-bullet');
      bullet.className = 'w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center font-label-md text-label-md text-on-surface-variant font-bold transition-colors choice-bullet';
      const icon = btn.querySelector('.choice-icon');
      icon.classList.remove('text-primary', 'text-error');
      icon.classList.add('text-transparent');
      icon.textContent = 'check_circle';
      icon.style.fontVariationSettings = "'FILL' 0";
      btn.querySelector('span.font-body-md').classList.remove('font-semibold');
    });

    buttonEl.classList.remove('bg-surface-container-low');
    const chosenBullet = buttonEl.querySelector('.choice-bullet');
    const chosenIcon = buttonEl.querySelector('.choice-icon');
    const chosenText = buttonEl.querySelector('span.font-body-md');
    chosenText.classList.add('font-semibold');

    if (isCorrect) {
      buttonEl.classList.add('bg-secondary-container/40', 'selected-quiz-row');
      chosenBullet.className = 'w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-md text-label-md font-bold shadow-xs choice-bullet';
      chosenIcon.className = 'material-symbols-outlined text-primary choice-icon text-[20px]';
      chosenIcon.style.fontVariationSettings = "'FILL' 1";

      feedbackBox.className = 'p-space-sm rounded-xl bg-secondary-container/30 transition-all duration-300 flex items-start gap-space-xs';
      feedbackBox.innerHTML = `
        <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">sentiment_satisfied</span>
        <div class="flex flex-col">
          <span class="font-label-md text-label-md font-bold text-primary">탁월한 판단입니다!</span>
          <p class="font-label-sm text-label-sm text-on-surface-variant mt-0.5 leading-relaxed">
            탈출 계획 없는 진입은 투자가 아니라 도박입니다. 기준이 서지 않았을 땐 쉬어가는 것도 훌륭한 전략입니다.
          </p>
        </div>
      `;

      if (progressBar) progressBar.style.width = '100%';
      if (stepNode3) {
        const badge = stepNode3.querySelector('span:first-child');
        badge.className = 'w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center font-label-sm text-label-sm font-bold shadow-xs';
        const label = stepNode3.querySelector('span:last-child');
        label.className = 'font-label-md text-label-md font-semibold text-primary';
      }
    } else {
      buttonEl.classList.add('bg-error-container/40');
      chosenBullet.className = 'w-6 h-6 rounded-full bg-error text-on-error flex items-center justify-center font-label-md text-label-md font-bold shadow-xs choice-bullet';
      chosenIcon.className = 'material-symbols-outlined text-error choice-icon text-[20px]';
      chosenIcon.textContent = 'cancel';
      chosenIcon.style.fontVariationSettings = "'FILL' 1";

      feedbackBox.className = 'p-space-sm rounded-xl bg-error-container/20 transition-all duration-300 flex items-start gap-space-xs';
      feedbackBox.innerHTML = `
        <span class="material-symbols-outlined text-error text-[20px] mt-0.5">error_outline</span>
        <div class="flex flex-col">
          <span class="font-label-md text-label-md font-bold text-error">다시 한 번 생각해보세요!</span>
          <p class="font-label-sm text-label-sm text-on-surface-variant mt-0.5 leading-relaxed">
            원칙 없이 들어간 매매는 물렸을 때 감정적 대응으로 이어져 계좌에 큰 치명타를 입힙니다.
          </p>
        </div>
      `;
    }
  }

  function toggleSeniorTip(buttonEl) {
    const icon = buttonEl.querySelector('.material-symbols-outlined');
    const label = buttonEl.querySelector('span:last-child');
    if (icon.textContent === 'bookmark_border') {
      icon.textContent = 'bookmark';
      icon.style.fontVariationSettings = "'FILL' 1";
      buttonEl.classList.add('text-tertiary');
      label.textContent = '저장됨';
    } else {
      icon.textContent = 'bookmark_border';
      icon.style.fontVariationSettings = "'FILL' 0";
      buttonEl.classList.remove('text-tertiary');
      label.textContent = '간직하기';
    }
  }

  function triggerStampCompletion(buttonEl) {
    const icon = document.getElementById('stamp-btn-icon');
    const text = document.getElementById('stamp-btn-text');
    
    buttonEl.disabled = true;
    buttonEl.classList.remove('bg-primary');
    buttonEl.classList.add('bg-secondary', 'scale-95');

    icon.textContent = 'hourglass_empty';
    text.textContent = '스탬프 찍는 중...';

    setTimeout(() => {
      buttonEl.classList.remove('scale-95');
      buttonEl.classList.add('bg-primary-container');
      icon.textContent = 'workspace_premium';
      icon.style.fontVariationSettings = "'FILL' 1";
      text.textContent = 'Day 14 학습 완료! 💮';

      // Delightful notification banner
      const toast = document.createElement('div');
      toast.className = 'fixed top-20 left-1/2 -translate-x-1/2 bg-inverse-surface text-inverse-on-surface px-space-md py-space-xs rounded-full shadow-xl flex items-center gap-2 z-50 font-label-md text-label-md animate-bounce';
      toast.innerHTML = '<span class="material-symbols-outlined text-[18px] text-tertiary-fixed">hotel_class</span> 14일차 학습지 완료 도장이 찍혔습니다!';
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3500);
    }, 600);
  }
